# Ключ Resend для отправки формы ПОЧТОЙ (https://resend.com/api-keys)
# Необязательно: основной канал доставки — Telegram (BOT_TOKEN ниже).
# Если ключа нет, заявки приходят только в Telegram.
RESEND_API_KEY=

# Куда приходит письмо из формы (используется только вместе с RESEND_API_KEY)
CONTACT_TO_EMAIL=kotokyura@gmail.com

# Отправитель. Без своего домена Resend разрешает onboarding@resend.dev
# и только на адрес владельца аккаунта.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Основной канал доставки заявок — Telegram-бот.
# Токен НЕ хранится в репозитории: задаётся в Vercel → Settings → Environment Variables
# (переменная BOT_TOKEN) или в .env.local при локальном запуске.
BOT_TOKEN=
CONTACT_CHAT_ID=
